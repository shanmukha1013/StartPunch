# Copy to backend/.env for local development. Never commit the real file.
GEMINI_API_KEY=
# Optional overrides
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemma-4-26b-a4b-it
# GEMINI_FAST_MODELS=gemini-flash-lite-latest,gemma-4-26b-a4b-it,gemini-3.1-flash-lite
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   (defaults to SQLite in backend/var/ locally)
# SESSION_SECRET=   (required in production, 32+ random characters; auto-generated locally)
# ADMIN_EMAILS=you@example.com
# CORS_ORIGINS=     (only if the frontend is served from a different origin)
# DAILY_REPORT_QUOTA=8
# DAILY_AI_QUOTA=120
